# Copy to .env (docker compose reads it) and edit. Only LYVUNE_MUSIC_DIR is required.

# The folder with your music, on the machine that runs Docker (required)
LYVUNE_MUSIC_DIR=/path/to/your/music

# Where Lyvune keeps its database and cache. A Docker volume by default; to use a folder instead, create it first
# and make sure the user below owns it:  mkdir -p /srv/lyvune && chown 1000:1000 /srv/lyvune
# LYVUNE_DATA=/srv/lyvune

# The port on this machine (the server always listens on 4533 inside the container).
# 127.0.0.1:4533 makes Lyvune reachable from this machine only, for use behind a reverse proxy on it
# LYVUNE_PORT=4533

# The user the server runs as, "uid:gid". `id -u` and `id -g` show yours
# LYVUNE_USER=1000:1000

# Time zone, for the scan schedule and log times
# TZ=Europe/Rome

# The image to run. Left alone it is built from this repository as lyvune:local. To run the published image, remove
# the # in front of the next line, and use `docker compose pull && docker compose up -d --no-build`
# LYVUNE_IMAGE=ghcr.io/tian-mc/lyvune:0.1.0-alpha.4
